# Copy this file to .env and replace the example values before going live.
PORT=3000
# Safe to use in the browser. Do not add any secret/service-role key here.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Temporary legacy local-server settings. These will be removed in the Supabase Auth migration.
ADMIN_PASSWORD=change-this-before-launch
TOKEN_SECRET=replace-with-a-long-random-secret-before-launch
# Optional: enables email delivery through Resend without exposing credentials in the browser.
RESEND_API_KEY=
EMAIL_FROM=Visiona Optical <onboarding@resend.dev>
